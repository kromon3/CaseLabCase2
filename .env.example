PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Разрешённые источники CORS через запятую
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting для /api
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Максимальный размер JSON-тела
BODY_LIMIT=100kb

# Внешний погодный API (модуль из Кейса 1)
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
REQUEST_TIMEOUT_MS=5000

# Правило пригодности окна для наружных работ
WEATHER_MAX_WIND_SPEED=10
WEATHER_MAX_PRECIPITATION=0
